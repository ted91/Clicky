# Which provider handles each step. Independent — mix and match freely.
# Options: mistral | openai | local   (anthropic is LLM-only, no STT)
STT_PROVIDER=mistral
LLM_PROVIDER=mistral

# --- Mistral (EU-hosted) ---
MISTRAL_API_KEY=
MISTRAL_STT_MODEL=voxtral-mini-latest
MISTRAL_LLM_MODEL=mistral-small-latest

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4.1-nano

# --- Anthropic (LLM_PROVIDER only) ---
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-haiku-4-5

# --- Google Calendar/Gmail/Tasks (meeting capture -- see google_client.py) ---
# One-time setup by the APP DEVELOPER, not each end user: create a project at
# https://console.cloud.google.com, enable the Calendar, Gmail, and Tasks
# APIs, then create an OAuth client (type "Desktop app") under Credentials.
# Paste its Client ID/Secret here before building the .app/.dmg -- every user
# of the built app then just clicks "Connect" and sees Google's own consent
# screen, no console work on their end. Leave blank to ship without this
# feature (the Integrations page just won't show a working Connect button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local (STT_PROVIDER=local uses faster-whisper, LLM_PROVIDER=local uses Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LOCAL_WHISPER_MODEL=base

# --- Device ---
# "wifi" (needs the device to have joined your network) or "ble" (works even
# if your router won't let the ESP32 join over 2.4GHz-only, at lower
# throughput — fine for short voice memos). See pipeline/README.md.
SYNC_TRANSPORT=wifi

# Only used when SYNC_TRANSPORT=wifi. IP printed in Serial Monitor as
# "wifi_sync: connected, IP=..."
DEVICE_BASE_URL=http://192.168.1.100

# Only used when SYNC_TRANSPORT=ble.
BLE_SCAN_TIMEOUT_SECONDS=10

# How often to check the device for new recordings. BLE keeps one
# persistent connection alive rather than reconnecting every cycle, so this
# can be short (just a characteristic read on an already-open connection).
POLL_INTERVAL_SECONDS=3

# How often to retry a recording whose processing already failed once (bad
# API key, rate limit). Freshly-synced recordings are always processed
# immediately regardless of this — it only throttles repeat failures.
PROCESS_RETRY_INTERVAL_SECONDS=30
